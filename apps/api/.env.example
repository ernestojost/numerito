NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://numerito:numerito@localhost:5432/numerito
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the browser uses (the web app; /api/* is proxied to this API)
BETTER_AUTH_URL=http://localhost:3000
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago (https://www.mercadopago.com/developers/panel/app). Leave the token empty to use the
# simulated checkout. The webhook secret comes from "Webhooks" in the same panel.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_CURRENCY=ARS
# Public URL of this API (a tunnel in development) so Mercado Pago can send webhooks
PUBLIC_API_URL=
# Production only: run without Mercado Pago using the simulated checkout (public demo)
ALLOW_SIMULATED_PAYMENTS=false
